# ============================================================
# NoneBot 基础配置
# ============================================================
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# 指令前缀（QQ 上发送 /myq 才能触发）
COMMAND_START=["/"]
COMMAND_SEP=["."]

# 超级用户：你的 QQ 号（可以触发 login 等敏感指令）
SUPERUSERS=["123456789"]

# 昵称（可选，@机器人时识别）
NICKNAME=["bot", "米游签"]

# 插件加载（二选一）：
#   方式 A: 在 bot.py 中用 nonebot.require("nonebot_plugin_mysdaily") 加载
#   方式 B: 在 pyproject.toml 的 [tool.nonebot] plugins 中添加
# 本文件的 PLUGINS 字段留空或注释掉，避免重复加载

# PLUGINS=["nonebot_plugin_mysdaily"]

# ============================================================
# OneBot V11 适配器连接
# ============================================================
# NoneBot 与 QQ 客户端（go-cqhttp / Lagrange / NapCat 等）连接方式：
#
# 方式一：反向 WebSocket（推荐，最稳。QQ 客户端主动连 NoneBot）
#   - NoneBot 这边什么都不用加
#   - 在 QQ 客户端里配置：ws://127.0.0.1:8080/onebot/v11/ws
#
# 方式二：正向 WebSocket（NoneBot 主动连 QQ 客户端）
#   - 取消下一行注释，并修改为客户端实际地址
# ONEBOT_V11_WS_URLS=["ws://127.0.0.1:5700"]
#
# 方式三：HTTP POST（QQ 客户端上报事件给 NoneBot）
#   - 取消下一行注释
# ONEBOT_V11_HTTP_WEBHOOK_URLS=["http://127.0.0.1:8080/onebot/v11/http"]
#
# 多种方式可以同时使用。一般只选一种即可。

# ============================================================
# 米游签插件配置（全部可选，留空读取 config.yaml）
# ============================================================

# 指令前缀，默认 myq（配合 COMMAND_START 即为 /myq）
MIYOUQIAN_COMMAND=myq

# 米游签 config.yaml 路径；留空则使用插件目录（nonebot_plugin_mysdaily/config.yaml）
MIYOUQIAN_CONFIG_PATH=

# 每日定时签到（留空则读取 config.yaml 的 schedule 配置）
# MIYOUQIAN_SCHEDULE_ENABLE=true
# MIYOUQIAN_SCHEDULE_TIME=00:00
# MIYOUQIAN_SCHEDULE_JITTER=30

# 手动执行签到后是否把结果回发给触发者
MIYOUQIAN_REPLY_ON_RUN=true

# 扫码登录等待超时（秒）
MIYOUQIAN_LOGIN_TIMEOUT=120
